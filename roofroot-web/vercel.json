{
  "env": {
    "NEXT_PUBLIC_API_URL": "https://roofroot-v2.onrender.com/api"
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "https://roofroot-v2.onrender.com/api/$1"
    }
  ],
  "domains": [
    "roofchains.com",
    "www.roofchains.com"
  ]
}
